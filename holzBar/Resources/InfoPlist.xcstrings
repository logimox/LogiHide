        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide muestra tus próximos eventos y sus enlaces de reunión en el centro del notch. Los lee solo en este Mac y nunca los envía ni los guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide affiche vos prochains événements et leurs liens de réunion dans le hub de l’encoche. Ils sont lus uniquement sur ce Mac et ne sont jamais envoyés ni enregistrés."
