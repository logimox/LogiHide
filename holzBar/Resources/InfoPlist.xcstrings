        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A LogiHide megjeleníti a következő eseményeit és az értekezlethivatkozásaikat a notch-központban. Csak ezen a Macen olvassa őket, és soha nem küldi el vagy tárolja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide menampilkan acara berikutnya dan tautan rapat Anda di pusat notch. LogiHide hanya membacanya di Mac ini dan tidak pernah mengirim atau menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide mostra i tuoi prossimi eventi e i relativi link delle riunioni nell’hub del notch. Vengono letti solo su questo Mac e non vengono mai inviati né salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide は、次の予定とその会議リンクをノッチハブに表示します。予定はこの Mac 上でのみ読み取られ、送信や保存は一切行われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide는 노치 허브에 다음 일정과 회의 링크를 표시합니다. 일정은 이 Mac에서만 읽으며 전송하거나 저장하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide toont je volgende afspraken en hun vergaderlinks in de notch-hub. Het leest ze alleen op deze Mac en verzendt of bewaart ze nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide pokazuje Twoje następne wydarzenia i linki do spotkań w centrum notcha. Odczytuje je tylko na tym Macu i nigdy ich nie wysyła ani nie zapisuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LogiHide mostra seus próximos eventos e os links de reunião deles no hub do notch. Ele os lê somente neste Mac e nunca os envia nem os armazena."
          }
        },
        "rm" : {
          "stringUnit" : {
