        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide zeigt deine nächsten Termine und ihre Meeting-Links im Notch-Hub. Sie werden nur auf diesem Mac gelesen und nie gesendet oder gespeichert."
