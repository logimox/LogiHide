    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Bluetooth usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide vidí, která z vašich spárovaných zařízení Bluetooth jsou připojena, aby na to mohla reagovat pravidla automatizace a upozornění na příslušenství. Nikdy se k zařízení nepřipojí, nehledá zařízení ani k žádnému nic neodesílá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide sieht, welche deiner gekoppelten Bluetooth-Geräte verbunden sind, damit Automatisierungsregeln und Zubehör-Hinweise darauf reagieren können. Es verbindet sich nie mit einem Gerät, sucht keine Geräte und sendet nichts an ein Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "LogiHide sees which of your paired Bluetooth devices are connected, so automation rules and accessory alerts can react to it. It never connects to a device, scans for devices or sends anything to one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide ve cuáles de tus dispositivos Bluetooth vinculados están conectados para que las reglas de automatización y los avisos de accesorios puedan reaccionar. Nunca se conecta a un dispositivo, busca dispositivos ni envía nada a ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide voit lesquels de vos appareils Bluetooth jumelés sont connectés afin que les règles d’automatisation et les alertes d’accessoires puissent y réagir. Elle ne se connecte jamais à un appareil, n’en recherche pas et ne lui envoie rien."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A LogiHide látja, hogy a párosított Bluetooth-eszközei közül melyek csatlakoznak, hogy az automatizálási szabályok és a tartozékriasztások reagálhassanak rá. Soha nem csatlakozik eszközhöz, nem keres eszközöket, és nem küld semmit egyiknek sem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide melihat perangkat Bluetooth Anda yang dipasangkan mana yang terhubung agar aturan otomatisasi dan peringatan aksesori dapat bereaksi. LogiHide tidak pernah terhubung ke perangkat, mencari perangkat, atau mengirim apa pun ke perangkat mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide vede quali dei tuoi dispositivi Bluetooth associati sono connessi, così le regole di automazione e gli avvisi degli accessori possono reagire. Non si connette mai a un dispositivo, non ne cerca e non invia nulla a un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide は、オートメーションルールやアクセサリの通知が反応できるように、ペアリング済みの Bluetooth デバイスのうちどれが接続中かを確認します。デバイスに接続したり、デバイスを検索したり、デバイスに何かを送信したりすることは一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide는 자동화 규칙과 액세서리 알림이 반응할 수 있도록 페어링된 Bluetooth 기기 중 어떤 기기가 연결되어 있는지 확인합니다. 기기에 연결하거나 기기를 검색하거나 기기로 무언가를 보내는 일은 절대 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide ziet welke van je gekoppelde Bluetooth-apparaten zijn verbonden, zodat automatiseringsregels en accessoiremeldingen erop kunnen reageren. Het maakt nooit verbinding met een apparaat, zoekt niet naar apparaten en stuurt niets naar een apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide widzi, które ze sparowanych urządzeń Bluetooth są połączone, aby reguły automatyzacji i alerty akcesoriów mogły na to reagować. Nigdy nie łączy się z urządzeniem, nie szuka urządzeń ani nic do nich nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LogiHide vê quais dos seus dispositivos Bluetooth pareados estão conectados para que as regras de automação e os avisos de acessórios possam reagir. Ele nunca se conecta a um dispositivo, procura dispositivos nem envia nada a nenhum."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide vesa tgenins da tes apparats Bluetooth colliads èn collià, per che las reglas d’automatisaziun e las avertenzas dals accessoris possian reagir. El na sa collia mai cun in apparat, na tschertga nagins apparats e na trametta nagut a in apparat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide видит, какие из ваших сопряжённых устройств Bluetooth подключены, чтобы правила автоматизации и оповещения об аксессуарах могли на это реагировать. Он никогда не подключается к устройствам, не ищет их и ничего им не отправляет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide ser vilka av dina parade Bluetooth-enheter som är anslutna så att automationsregler och tillbehörsvarningar kan reagera på det. Den ansluter aldrig till en enhet, söker inte efter enheter och skickar ingenting till någon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide, otomasyon kuralları ve aksesuar uyarıları tepki verebilsin diye eşlenmiş Bluetooth aygıtlarınızdan hangilerinin bağlı olduğunu görür. Bir aygıta asla bağlanmaz, aygıt aramaz ve hiçbirine bir şey göndermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide бачить, які з ваших спарених пристроїв Bluetooth підключено, щоб правила автоматизації та сповіщення про аксесуари могли на це реагувати. Він ніколи не підключається до пристроїв, не шукає їх і нічого їм не надсилає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide 会查看你已配对的蓝牙设备中哪些已连接，以便自动化规则和配件提醒可以据此做出反应。它绝不会连接设备、搜索设备或向设备发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LogiHide 會查看你已配對的藍牙裝置中有哪些已連線，讓自動化規則與配件提醒可以對此做出反應。它絕不會連接裝置、搜尋裝置或向裝置傳送任何內容。"
          }
        }
      }
    },
